# ==========================================
# VELA LATINA MONTE DI PROCIDA - ENVIRONMENT EXAMPLE
# ==========================================

# URL Ufficiale del sito (utilizzato per metadati, canonical, sitemap e link email)
NEXT_PUBLIC_SITE_URL=https://vela-latina-monte-di-procida.vercel.app

# Password e protezione anteprima sito
SITE_PROTECTION_ENABLED=true
SITE_PASSWORD=velalatina2026

# Chiave segreta per sessioni JWT e cookie protetti
JWT_SECRET=your_jwt_secret_random_64_characters_here

# Email ricezione notifiche iscrizioni e tesseramenti
NOTIFICATION_EMAIL=vistamirko@gmail.com

# Servizio Notifiche Email Principale: Resend API (ottimizzato per Vercel)
RESEND_API_KEY=re_your_resend_api_key_here

# Servizio Notifiche Fallback: SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vistamirko@gmail.com
SMTP_PASS=your_app_password_here

# Coordinate Bancarie Associazione (opzionale)
# ASSOCIATION_IBAN=IT00X0000000000000000000000
