# ==========================================
# VELA LATINA MONTE DI PROCIDA - ENVIRONMENT EXAMPLE
# ==========================================

# URL Ufficiale del sito (utilizzato per metadati, canonical, sitemap e link email)
SITE_URL=https://www.velalatinamontediprocida.com

# Password e protezione anteprima sito
SITE_PROTECTION_ENABLED=true
SITE_PASSWORD=your_site_preview_password

# Chiave segreta per sessioni JWT e cookie protetti
JWT_SECRET=your_jwt_secret_random_64_characters_here

# Email ricezione notifiche iscrizioni e tesseramenti (destinatario principale e copia conoscenza)
NOTIFICATION_EMAIL=velalatinamontediprocida@gmail.com, vistamirko@gmail.com
NOTIFICATION_CC=vistamirko@gmail.com

# Servizio Notifiche Email Principale: Resend API (ottimizzato per Vercel)
RESEND_API_KEY=re_your_resend_api_key_here

# Servizio Notifiche Fallback: SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vistamirko@gmail.com
SMTP_PASS=your_app_password_here

# Coordinate Bancarie Associazione (opzionale)
# ASSOCIATION_IBAN=IT00X0000000000000000000000

# ==========================================
# CREDENZIALI ACCESSI PANNELLO ADMIN (/admin/login) - RIFERIMENTO LOCALE
# ==========================================
# ADMIN_SUPERADMIN_EMAIL=admin@velalatinamontediprocida.it
# ADMIN_SUPERADMIN_PASSWORD=your_admin_password_here
# ADMIN_SEGRETERIA_EMAIL=segreteria@velalatinamontediprocida.it
# ADMIN_SEGRETERIA_PASSWORD=your_segreteria_password_here
# ADMIN_EDITOR_EMAIL=comunicazione@velalatinamontediprocida.it
# ADMIN_EDITOR_PASSWORD=your_editor_password_here
# ADMIN_ISTRUTTORI_EMAIL=istruttori@velalatinamontediprocida.it
# ADMIN_ISTRUTTORI_PASSWORD=your_istruttori_password_here
